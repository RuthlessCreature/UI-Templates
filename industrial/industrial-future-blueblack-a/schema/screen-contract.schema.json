{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Industrial UI Screen Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen_id",
    "platform",
    "primary_user",
    "user_task",
    "location_context",
    "current_state",
    "information",
    "exceptions",
    "actions",
    "required_states",
    "acceptance_criteria"
  ],
  "properties": {
    "screen_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "platform": {
      "enum": [
        "desktop",
        "web",
        "mobile",
        "ppt"
      ]
    },
    "primary_user": {
      "type": "string",
      "minLength": 1
    },
    "user_task": {
      "type": "string",
      "minLength": 1
    },
    "location_context": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "current_state": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "information": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "L1",
        "L2",
        "L3",
        "L4"
      ],
      "properties": {
        "L1": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string"
          }
        },
        "L2": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "L3": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "L4": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "surface",
          "requires_action"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "surface": {
            "enum": [
              "persistent",
              "inline",
              "toast",
              "dialog",
              "drawer"
            ]
          },
          "requires_action": {
            "type": "boolean"
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "dangerous"
      ],
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dangerous": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
